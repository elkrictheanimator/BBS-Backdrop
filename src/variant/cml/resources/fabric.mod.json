{
	"schemaVersion": 1,
	"id": "backdrop",
	"version": "${version}",
	"name": "BBS Backdrop",
	"description": "Video with sound behind BBS (wallpaper), and Spotify in it. An addon for BBS CML.",
	"license": "MIT",
	"icon": "assets/backdrop/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": ["com.backdrop.BackdropInit"],
		"bbs-addon": ["com.backdrop.BackdropAddon"],
		"bbs-addon-client": ["com.backdrop.BackdropClient"]
	},
	"mixins": [
		{
			"config": "backdrop.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.15.0",
		"fabric-api": "*",
		"minecraft": "~${minecraft}",
		"java": ">=${java}",
		"bbs": "*"
	}
}
