{
	"schemaVersion": 1,
	"id": "backdrop",
	"version": "${version}",
	"name": "Backdrop",
	"description": "Video with sound behind BBS (wallpaper and banner), and Spotify in it. An addon for BBS-RE.",
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
		"bbs-addon": ["com.backdrop.BackdropAddon"],
		"bbs-client-addon": ["com.backdrop.BackdropClient"]
	},
	"mixins": [
		{
			"config": "backdrop.mixins.json",
			"environment": "client"
		},
		{
			"config": "backdrop.banner.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.16.0",
		"fabric-api": "*",
		"minecraft": "~1.20.4",
		"java": ">=17",
		"bbs": ">=2.7"
	}
}
