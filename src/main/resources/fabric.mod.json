{
	"schemaVersion": 1,
	"id": "backdrop",
	"version": "${version}",
	"name": "BBS Backdrop",
	"description": "Video backdrops with sound for BBS (the landing banner and a wallpaper behind every editor), and Spotify in them.",
	"license": "MIT",
	"environment": "client",
	"entrypoints": {
		"client": ["com.backdrop.Backdrop"]
	},
	"mixins": [
		{
			"config": "backdrop.mixins.json",
			"environment": "client"
		},
		{
			"config": "backdrop.banner.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.15.0",
		"fabric-api": "*",
		"minecraft": "~1.20.4",
		"java": ">=17",
		"bbs": "*"
	}
}
